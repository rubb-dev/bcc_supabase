---
interface Props {
    class?: string;
    as?: string;
}

const { class: className, as: Tag = "div", ...rest } = Astro.props;
---

<Tag
    class:list={[
        "rounded-xl border border-slate-200 bg-white text-slate-950 shadow-sm",
        className,
    ]}
    {...rest}
>
    <slot />
</Tag>
