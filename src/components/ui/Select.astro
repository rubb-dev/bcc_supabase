---
interface Props extends astroHTML.JSX.SelectHTMLAttributes {
    label?: string;
    error?: string;
    containerClass?: string;
    options?: {
        value: string;
        label: string;
        disabled?: boolean;
        selected?: boolean;
    }[];
}

const {
    label,
    error,
    containerClass,
    class: className,
    id,
    options = [],
    ...rest
} = Astro.props;
---

<div class:list={["flex flex-col gap-1.5", containerClass]}>
    {
        label && (
            <label for={id} class="text-sm font-medium text-slate-700">
                {label}
            </label>
        )
    }
    <div class="relative">
        <select
            id={id}
            class:list={[
                "flex h-10 w-full appearance-none rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-slate-900 focus:border-transparent disabled:cursor-not-allowed disabled:opacity-50 transition-all",
                error && "border-red-500 focus:ring-red-500",
                className,
            ]}
            {...rest}
        >
            <slot>
                {
                    options.map((opt) => (
                        <option
                            value={opt.value}
                            disabled={opt.disabled}
                            selected={opt.selected}
                        >
                            {opt.label}
                        </option>
                    ))
                }
            </slot>
        </select>
        <div
            class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-2 text-slate-500"
        >
            <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 20 20"
                fill="currentColor"
                class="h-4 w-4"
            >
                <path
                    fill-rule="evenodd"
                    d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z"
                    clip-rule="evenodd"></path>
            </svg>
        </div>
    </div>
    {error && <p class="text-xs text-red-600">{error}</p>}
</div>
