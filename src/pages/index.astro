---
import Layout from "@/layouts/Layout.astro";

type VehicleType = {
  id: string;
  name: string;
  slug: string;
};

type Load = {
  id: string;
  created_at: string;
  origin_city_name: string;
  origin_country_code: string;
  destination_city_name: string;
  destination_country_code: string;
  valid_from: string;
  valid_until: string;
  weight_t: number;
  is_palletized: boolean;
  description?: string | null;
  vehicle_types: VehicleType[];
};

// Llamada al endpoint interno /api/loads
let loads: Load[] = [];
let loadsError = false;

try {
  const res = await fetch(`${Astro.url.origin}/api/loads`);
  if (!res.ok) {
    loadsError = true;
    console.error("Error al obtener loads desde /api/loads:", await res.text());
  } else {
    loads = (await res.json()) as Load[];
  }
} catch (err) {
  loadsError = true;
  console.error("Fallo al llamar /api/loads:", err);
}

function formatDate(dateStr: string) {
  return new Date(dateStr).toLocaleDateString("es-ES");
}

function formatRelative(dateStr: string) {
  const date = new Date(dateStr);
  const diffMs = Date.now() - date.getTime();
  const diffMinutes = Math.floor(diffMs / 60000);
  const diffHours = Math.floor(diffMinutes / 60);
  const diffDays = Math.floor(diffHours / 24);

  if (diffMinutes < 1) return "hace unos segundos";
  if (diffMinutes < 60) return `hace ${diffMinutes} min`;
  if (diffHours < 24) return `hace ${diffHours} h`;
  return `hace ${diffDays} d`;
}
---

<Layout title="CargoMarket — Bolsa de cargas simple" description="Conecta cargadores y transportistas verificados. Publica cargas, encuentra camiones y gestiona tu logística fácilmente.">

  <!-- Hero principal -->
  <section class="relative overflow-hidden">
    <div class="absolute inset-0 -z-10 bg-linear-to-br from-sky-50 via-white to-slate-100"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14 lg:py-20 grid lg:grid-cols-2 gap-10 items-center">
      <div>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-semibold leading-tight">
          Una <span class="text-sky-700">bolsa de cargas</span> simple y de confianza
        </h1>
        <p class="mt-4 text-slate-600 max-w-xl">
          Conecta cargadores y transportistas verificados. Publica cargas, encuentra camiones y cierra acuerdos en minutos.
        </p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a href="/auth/register" class="px-5 py-3 rounded-lg bg-sky-600 text-white hover:bg-sky-700">Crear cuenta gratis</a>
          <a href="/auth/signin" class="px-5 py-3 rounded-lg border border-slate-300 text-slate-700 hover:bg-white">Iniciar sesión</a>
        </div>

        <dl class="mt-8 grid grid-cols-3 gap-4 text-center">
          <div class="rounded-xl bg-white shadow-sm p-4">
            <dt class="text-xs uppercase tracking-wide text-slate-500">Cargas publicadas</dt>
            <dd class="text-xl font-semibold">1.5M+</dd>
          </div>
          <div class="rounded-xl bg-white shadow-sm p-4">
            <dt class="text-xs uppercase tracking-wide text-slate-500">Camiones</dt>
            <dd class="text-xl font-semibold">100k+</dd>
          </div>
          <div class="rounded-xl bg-white shadow-sm p-4">
            <dt class="text-xs uppercase tracking-wide text-slate-500">Miembros activos</dt>
            <dd class="text-xl font-semibold">25k</dd>
          </div>
        </dl>
      </div>

      <!-- Tarjeta lateral tipo buscador -->
      <div class="lg:pl-10">
        <div class="backdrop-blur-md bg-white/80 rounded-2xl shadow border border-white/60">
          <div class="p-2 border-b border-slate-200 flex gap-2">
            <button class="px-3 py-2 text-sm rounded-lg bg-slate-900 text-white">Cargas</button>
            <button class="px-3 py-2 text-sm rounded-lg text-slate-600 hover:bg-white">Camiones</button>
            <button class="px-3 py-2 text-sm rounded-lg text-slate-600 hover:bg-white">Incidentes</button>
          </div>
          <div class="p-4 grid gap-3">
            <div class="grid sm:grid-cols-3 gap-3">
              <input class="col-span-1 rounded-lg border border-slate-300 px-3 py-2" placeholder="Origen" />
              <input class="col-span-1 rounded-lg border border-slate-300 px-3 py-2" placeholder="Destino" />
              <select class="col-span-1 rounded-lg border border-slate-300 px-3 py-2">
                <option>Camión lona</option>
                <option>Frigorífico</option>
                <option>Plataforma</option>
              </select>
            </div>
            <button class="w-full rounded-lg bg-sky-600 text-white py-2.5 hover:bg-sky-700">Buscar</button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========================== -->
  <!--   ÚLTIMAS CARGAS PUBLICADAS (estilo Cargopedia) -->
  <!-- ========================== -->

  <section class="py-10 border-t border-slate-200 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between mb-4 gap-3">
        <h2 class="text-xl font-semibold">Últimas cargas publicadas</h2>
        <a href="/auth/register" class="text-sm text-sky-700 hover:underline">
          Publica tu primera carga →
        </a>
      </div>

      {loadsError && (
        <p class="text-sm text-red-600">Ha habido un problema al cargar las cargas.</p>
      )}

      {!loadsError && loads.length === 0 && (
        <p class="text-sm text-slate-500">
          Todavía no hay cargas publicadas. Sé el primero en publicar una.
        </p>
      )}

      {!loadsError && loads.length > 0 && (
        <div class="space-y-3">
          {loads.map((load) => (
            <article
              data-id={load.id}
              class="rounded-xl border border-slate-200 bg-white shadow-sm overflow-hidden"
            >
              <div class="flex flex-col md:flex-row">
                {/* Zona principal: ruta, validez, descripción */}
                <div class="flex-1 p-4 md:p-5">
                  {/* Ruta origen -> destino */}
                  <div class="flex items-start justify-between gap-3">
                    <div class="flex flex-wrap items-center gap-2 text-sm">
                      <div class="flex items-center gap-1">
                        <span class="font-semibold text-slate-900">
                          {load.origin_city_name}
                        </span>
                        <span class="text-xs rounded-full bg-slate-100 px-2 py-0.5 text-slate-600">
                          {load.origin_country_code}
                        </span>
                      </div>

                      <span class="text-slate-400 text-sm">→</span>

                      <div class="flex items-center gap-1">
                        <span class="font-semibold text-slate-900">
                          {load.destination_city_name}
                        </span>
                        <span class="text-xs rounded-full bg-slate-100 px-2 py-0.5 text-slate-600">
                          {load.destination_country_code}
                        </span>
                      </div>
                    </div>

                    <span class="text-xs text-slate-500 whitespace-nowrap">
                      {formatRelative(load.created_at)}
                    </span>
                  </div>

                  {/* Badges inferiores: validez, paletizado, tipos de camión */}
                  <div class="mt-2 flex flex-wrap items-center gap-2 text-[11px] text-slate-600">
                    <span class="inline-flex items-center gap-1 rounded-full bg-sky-50 px-2 py-1 border border-sky-100 text-sky-700">
                      Validez: {formatDate(load.valid_from)} – {formatDate(load.valid_until)}
                    </span>

                    <span class="inline-flex items-center gap-1 rounded-full bg-emerald-50 px-2 py-1 border border-emerald-100 text-emerald-700">
                      {load.is_palletized ? "Carga paletizada" : "Sin paletizar"}
                    </span>

                    {load.vehicle_types && load.vehicle_types.length > 0 && (
                      <div class="flex flex-wrap gap-1">
                        {load.vehicle_types.map((vt) => (
                          <span
                            class="inline-flex items-center gap-1 rounded-full bg-amber-50 px-2 py-1 border border-amber-100 text-amber-800"
                            title={vt.slug}
                          >
                            🚚 {vt.name}
                          </span>
                        ))}
                      </div>
                    )}
                  </div>

                  {/* Descripción corta */}
                  {load.description && (
                    <p class="mt-2 text-xs text-slate-600">
                      {load.description}
                    </p>
                  )}
                </div>

                {/* Columna derecha: peso + botón */}
                <div class="w-full md:w-44 border-t md:border-t-0 md:border-l border-slate-100 flex md:flex-col items-center justify-between md:justify-center gap-3 p-4">
                  <div class="text-right md:text-center">
                    <div class="text-xs uppercase tracking-wide text-slate-500">
                      Peso total
                    </div>
                    <div class="text-xl font-semibold text-slate-900">
                      {Number(load.weight_t).toLocaleString("es-ES", {
                        minimumFractionDigits: 0,
                        maximumFractionDigits: 2,
                      })}
                      <span class="text-sm font-normal text-slate-500"> t</span>
                    </div>
                  </div>

                  <button class="inline-flex items-center rounded-full bg-sky-600 text-white px-4 py-1.5 text-xs font-medium hover:bg-sky-700">
                    Ver detalles
                  </button>
                </div>
              </div>
            </article>
          ))}
        </div>
      )}
    </div>
  </section>
  
  <!-- CTA final -->
  <section class="py-14">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="rounded-2xl bg-slate-900 text-white p-8 md:p-12 flex flex-col md:flex-row items-center justify-between gap-6">
        <div>
          <h3 class="text-2xl font-semibold">Empieza gratis en minutos</h3>
          <p class="text-slate-300 mt-1">Publica tu primera carga o encuentra camión ahora.</p>
        </div>
        <div class="flex gap-3">
          <a href="/auth/register" class="px-5 py-3 rounded-lg bg-white text-slate-900 hover:bg-slate-200">Crear cuenta</a>
          <a href="/auth/signin" class="px-5 py-3 rounded-lg border border-white/30 hover:bg-white/10">Iniciar sesión</a>
        </div>
      </div>
    </div>
  </section>

</Layout>
