---
import Layout from "@/layouts/AuthLayout.astro";
import { supabase } from "@/lib/supabase";
import Card from "@/components/ui/Card.astro";
import Input from "@/components/ui/Input.astro";
import Select from "@/components/ui/Select.astro";
import Button from "@/components/ui/Button.astro";

// 1) Recuperar sesión
const accessToken = Astro.cookies.get("sb-access-token");
const refreshToken = Astro.cookies.get("sb-refresh-token");

if (!accessToken || !refreshToken) {
  return Astro.redirect("/auth/signin");
}

const { data: sessData, error: sessErr } = await supabase.auth.setSession({
  access_token: accessToken.value!,
  refresh_token: refreshToken.value!,
});

if (sessErr || !sessData?.user) {
  Astro.cookies.delete("sb-access-token", { path: "/" });
  Astro.cookies.delete("sb-refresh-token", { path: "/" });
  return Astro.redirect("/auth/signin");
}

const user = sessData.user;

// 2) Verificar email confirmado
if (!user.email_confirmed_at) {
  return Astro.redirect("/check-email");
}

// 3) Si ya tiene perfil, no permitir esta página
const { data: existingProfile } = await supabase
  .from("profiles")
  .select("user_id")
  .eq("user_id", user.id)
  .maybeSingle();

if (existingProfile) {
  return Astro.redirect("/dashboard");
}

// 4) Capturar error opcional por query (?error=profile)
const url = new URL(Astro.request.url);
const error = url.searchParams.get("error");
const errorMessage =
  error === "profile"
    ? "No se pudo guardar tu perfil. Inténtalo de nuevo."
    : "";
---

<Layout title="Completa tu perfil | CargoMarket">
  <section
    class="relative min-h-screen flex items-center justify-center px-6 py-20 bg-slate-50"
  >
    <Card class="w-full max-w-md p-8">
      <div class="text-center mb-8">
        <div
          class="mx-auto w-12 h-12 rounded-xl bg-slate-900 text-white flex items-center justify-center text-xl font-bold"
        >
          C
        </div>
        <h1 class="text-2xl font-bold mt-4 text-slate-900">
          Completa tu perfil
        </h1>
        <p class="text-sm text-slate-600 mt-2">
          Hola, <span class="font-medium text-slate-900">{user.email}</span>.
          Añade tus datos para continuar.
        </p>
      </div>

      {
        errorMessage && (
          <div
            class="bg-red-50 border border-red-100 text-red-700 px-4 py-3 rounded-lg text-sm mb-6"
            role="alert"
          >
            {errorMessage}
          </div>
        )
      }

      <form
        id="create-profile-form"
        action="/api/profile/create"
        method="post"
        class="space-y-6"
        novalidate
      >
        <!-- Empresa -->
        <Input
          label="Nombre de empresa *"
          name="company_name"
          id="company_name"
          required
          placeholder="Ej: Vetonek"
        />

        <!-- Rol -->
        <Select
          label="Rol *"
          name="role"
          id="role"
          required
          options={[
            {
              value: "",
              label: "Selecciona tu rol",
              disabled: true,
              selected: true,
            },
            { value: "cargador", label: "Cargador" },
            { value: "transportista", label: "Transportista" },
          ]}
        />

        <!-- Guardar -->
        <Button type="submit" class="w-full"> Guardar y continuar </Button>

        <p class="text-xs text-slate-500 text-center">
          Todos los campos son obligatorios.
        </p>
      </form>
    </Card>
  </section>

  <!-- Validación mínima en cliente -->
  <script is:inline>
    const form = document.getElementById("create-profile-form");
    const company = document.getElementById("company_name");
    const role = document.getElementById("role");

    form.addEventListener("submit", (e) => {
      if (!company.value.trim()) {
        e.preventDefault();
        alert("El nombre de empresa es obligatorio.");
        company.focus();
        return;
      }
      if (!role.value) {
        e.preventDefault();
        alert("Selecciona un rol.");
        role.focus();
        return;
      }
    });
  </script>
</Layout>
