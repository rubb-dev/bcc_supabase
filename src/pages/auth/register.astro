---
import AuthLayout from "@/layouts/AuthLayout.astro";
import Card from "@/components/ui/Card.astro";
import Input from "@/components/ui/Input.astro";
import Button from "@/components/ui/Button.astro";

const url = new URL(Astro.request.url);
const error = url.searchParams.get("error");

let errorMessage = "";
if (error === "missing") errorMessage = "Por favor, completa todos los campos.";
if (error === "exists")
  errorMessage = "Este correo ya está registrado. Inicia sesión o usa otro.";
if (error === "server")
  errorMessage = "No se pudo crear la cuenta. Inténtalo más tarde.";
---

<AuthLayout title="Crear cuenta | CargoMarket">
  <div class="absolute top-4 left-4 md:top-8 md:left-8">
    <Button as="a" href="/" variant="ghost" size="sm" class="gap-2">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 24 24"
        stroke-width="1.5"
        stroke="currentColor"
        class="w-4 h-4"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18"></path>
      </svg>
      Volver al inicio
    </Button>
  </div>
  <div class="w-full max-w-md">
    <div class="text-center mb-10">
      <div
        class="mx-auto w-12 h-12 rounded-xl bg-slate-900 text-white flex items-center justify-center text-xl font-bold shadow-lg shadow-slate-900/20"
      >
        C
      </div>
      <h1 class="text-2xl font-bold mt-6 text-slate-900">Crear cuenta</h1>
      <p class="text-slate-600 mt-2">
        ¿Ya tienes una cuenta?
        <a
          href="/auth/signin"
          class="text-slate-900 hover:underline font-medium">Inicia sesión</a
        >
      </p>
    </div>

    <Card class="p-8 shadow-xl border-slate-200/60">
      <!-- Mensaje de error (backend + validación cliente) -->
      <div
        id="form-error"
        class={`${
          errorMessage ? "" : "hidden"
        } mb-6 rounded-lg bg-red-50 p-3 text-sm text-red-600 border border-red-100`}
        role="alert"
      >
        {errorMessage}
      </div>

      <form
        id="register-form"
        action="/api/auth/register"
        method="post"
        class="space-y-5"
        novalidate
      >
        <Input
          label="Email *"
          type="email"
          name="email"
          id="email"
          required
          autocomplete="email"
          placeholder="tucorreo@ejemplo.com"
        />

        <!-- Password con toggle manual para mantener funcionalidad -->
        <div>
          <label
            for="password"
            class="block text-sm font-medium text-slate-700 mb-1.5"
            >Contraseña *</label
          >
          <div class="relative">
            <input
              type="password"
              name="password"
              id="password"
              required
              minlength="6"
              autocomplete="new-password"
              class="flex h-10 w-full rounded-lg border border-slate-300 bg-white px-3 py-2 pr-10 text-sm placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-slate-900 focus:border-transparent disabled:cursor-not-allowed disabled:opacity-50 transition-all"
              placeholder="********"
            />
            <button
              type="button"
              data-toggle="pw1"
              class="absolute inset-y-0 right-0 flex items-center px-3 text-slate-500 hover:text-slate-700 focus:outline-none"
            >
              <span class="text-xs font-medium">Ver</span>
            </button>
          </div>
          <p class="text-xs text-slate-500 mt-1.5">Mínimo 6 caracteres</p>

          <!-- Indicador de fuerza -->
          <div
            id="pw-strength"
            class="h-1 rounded-full mt-2 bg-slate-100 overflow-hidden"
          >
            <div id="pw-bar" class="h-full w-0 transition-all duration-300">
            </div>
          </div>
        </div>

        <!-- Confirmar contraseña -->
        <div>
          <label
            for="password2"
            class="block text-sm font-medium text-slate-700 mb-1.5"
            >Repite la contraseña *</label
          >
          <div class="relative">
            <input
              type="password"
              name="password2"
              id="password2"
              required
              minlength="6"
              autocomplete="new-password"
              class="flex h-10 w-full rounded-lg border border-slate-300 bg-white px-3 py-2 pr-10 text-sm placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-slate-900 focus:border-transparent disabled:cursor-not-allowed disabled:opacity-50 transition-all"
              placeholder="********"
            />
            <button
              type="button"
              data-toggle="pw2"
              class="absolute inset-y-0 right-0 flex items-center px-3 text-slate-500 hover:text-slate-700 focus:outline-none"
            >
              <span class="text-xs font-medium">Ver</span>
            </button>
          </div>
        </div>

        <!-- Términos -->
        <div class="flex items-start gap-3">
          <input
            id="terms"
            name="terms"
            type="checkbox"
            required
            class="mt-1 h-4 w-4 rounded border-slate-300 text-slate-900 focus:ring-slate-900"
          />
          <label for="terms" class="text-sm text-slate-600">
            Acepto las <a
              href="/terminos"
              class="text-slate-900 hover:underline">Condiciones de uso</a
            > y la
            <a href="/privacidad" class="text-slate-900 hover:underline"
              >Política de privacidad</a
            >.
          </label>
        </div>

        <Button type="submit" class="w-full" size="lg"> Registrarme </Button>

        <p class="text-xs text-slate-500 text-center">
          Todos los campos son obligatorios.
        </p>
      </form>
    </Card>
  </div>

  <script is:inline>
    const form = document.getElementById("register-form");
    const pw1 = document.getElementById("password");
    const pw2 = document.getElementById("password2");
    const bar = document.getElementById("pw-bar");
    const err = document.getElementById("form-error");

    // Mostrar / ocultar contraseña
    document.querySelectorAll("[data-toggle]").forEach((btn) => {
      btn.addEventListener("click", () => {
        const target = btn.getAttribute("data-toggle") === "pw1" ? pw1 : pw2;
        const isText = target.type === "text";
        target.type = isText ? "password" : "text";
        const span = btn.querySelector("span");
        if (span) span.textContent = isText ? "Ver" : "Ocultar";
      });
    });

    // Indicador de fuerza simple
    pw1.addEventListener("input", (e) => {
      const val = e.target.value;
      let w = 0;
      if (val.length >= 6) w = 33;
      if (/[A-Z]/.test(val) && /[a-z]/.test(val)) w = 66;
      if (/\d/.test(val) && /[^A-Za-z0-9]/.test(val)) w = 100;
      bar.style.width = w + "%";
      bar.style.background =
        w < 34 ? "#ef4444" : w < 67 ? "#f59e0b" : "#10b981";
    });

    // Validación en cliente (bloquea envío)
    form.addEventListener("submit", (e) => {
      err.classList.add("hidden");
      err.textContent = "";

      const email = form.email.value.trim();
      const pass1 = pw1.value;
      const pass2 = pw2.value;
      const terms = document.getElementById("terms");

      if (!email) {
        e.preventDefault();
        err.textContent = "El email es obligatorio.";
        err.classList.remove("hidden");
        form.email.focus();
        return;
      }

      if (pass1.length < 6) {
        e.preventDefault();
        err.textContent = "La contraseña debe tener al menos 6 caracteres.";
        err.classList.remove("hidden");
        pw1.focus();
        return;
      }

      if (pass1 !== pass2) {
        e.preventDefault();
        err.textContent = "Las contraseñas no coinciden.";
        err.classList.remove("hidden");
        pw2.focus();
        return;
      }

      if (!terms.checked) {
        e.preventDefault();
        err.textContent = "Debes aceptar los términos para continuar.";
        err.classList.remove("hidden");
        terms.focus();
        return;
      }
    });
  </script>
</AuthLayout>
