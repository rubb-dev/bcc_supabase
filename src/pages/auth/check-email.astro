---
import Layout from "@/layouts/AuthLayout.astro";
import { supabase } from "@/lib/supabase";
import Card from "@/components/ui/Card.astro";
import Button from "@/components/ui/Button.astro";

const accessToken = Astro.cookies.get("sb-access-token");
const refreshToken = Astro.cookies.get("sb-refresh-token");

// email preferente: sesión -> cookie pending-email
let userEmail: string | null = null;
let verified = false;

if (accessToken?.value && refreshToken?.value) {
  const { data: sessData } = await supabase.auth.setSession({
    access_token: accessToken.value,
    refresh_token: refreshToken.value,
  });
  const user = sessData?.user;
  if (user) {
    userEmail = user.email ?? null;
    if (user.email_confirmed_at) verified = true;
  }
}

if (!userEmail) {
  userEmail = Astro.cookies.get("pending-email")?.value ?? null;
}

// Si ya está verificado, pasar al siguiente paso
if (verified) {
  // podemos borrar la cookie temporal
  Astro.cookies.delete("pending-email", { path: "/" });
  return Astro.redirect("/profile/create");
}

const url = new URL(Astro.request.url);
const resent = url.searchParams.get("resent") === "1";
---

<Layout title="Revisa tu correo | CargoMarket">
  <section
    class="relative min-h-screen flex items-center justify-center px-6 py-20 bg-slate-50"
  >
    <Card class="w-full max-w-md p-8 text-center">
      <div
        class="mx-auto w-12 h-12 rounded-xl bg-slate-900 text-white flex items-center justify-center text-xl font-bold"
      >
        C
      </div>

      <h1 class="text-2xl font-bold mt-6 text-slate-900">Confirma tu cuenta</h1>

      <p class="text-slate-600 mt-3">
        Te hemos enviado un correo de confirmación{userEmail ? " a:" : ""}
      </p>
      {userEmail && <p class="text-slate-900 font-medium mt-1">{userEmail}</p>}

      <p class="text-slate-600 mt-3">
        Revisa tu bandeja de entrada (y spam) y haz clic en el enlace para
        activar tu cuenta.
      </p>

      <div class="flex justify-center my-8">
        <div class="p-4 bg-sky-50 rounded-full">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="w-12 h-12 text-sky-600"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="1.5"
              d="M3 8l9 6 9-6M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
            ></path>
          </svg>
        </div>
      </div>

      {
        resent && (
          <div
            class="bg-emerald-50 border border-emerald-100 text-emerald-700 px-4 py-3 rounded-lg text-sm mb-6"
            role="status"
          >
            Correo reenviado. Revisa tu bandeja de entrada.
          </div>
        )
      }

      {
        userEmail ? (
          <form
            action="/api/auth/resend-confirmation"
            method="post"
            class="inline-block w-full"
          >
            <input type="hidden" name="email" value={userEmail} />
            <Button type="submit" class="w-full">
              Reenviar correo de verificación
            </Button>
          </form>
        ) : (
          <p class="text-slate-500 text-sm italic">
            No se pudo determinar tu email. Vuelve al registro.
          </p>
        )
      }

      <p class="text-sm text-slate-500 mt-8">
        Si ya has confirmado el correo, <a
          href="/auth/signin"
          class="text-slate-900 font-medium hover:underline"
          >inicia sesión aquí</a
        >.
      </p>
    </Card>
  </section>
</Layout>
