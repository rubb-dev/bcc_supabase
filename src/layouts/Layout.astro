---
import "@/styles/global.css";

interface Props {
	title?: string;
	description?: string;
}

const {
	title = "CargoMarket — Bolsa de cargas simple",
	description = "Conecta cargadores y transportistas verificados. Publica cargas y encuentra camiones fácilmente.",
} = Astro.props;
---

<!doctype html>
<html lang="es" class="h-full bg-slate-50 antialiased">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>

		<!-- Fuente Inter -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>

		<style>
			:root {
				font-family:
					"Inter",
					system-ui,
					-apple-system,
					sans-serif;
			}
		</style>
	</head>

	<body class="flex min-h-full flex-col text-slate-900">
		<main class="flex-1">
			<slot />
		</main>

		<footer class="border-t border-slate-200 bg-white py-8">
			<div
				class="mx-auto max-w-7xl px-4 text-center text-sm text-slate-500 sm:px-6 lg:px-8"
			>
				<p>
					&copy; {new Date().getFullYear()} CargoMarket. Todos los derechos
					reservados.
				</p>
			</div>
		</footer>
	</body>
</html>
